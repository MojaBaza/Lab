// TASK 1: Function Overloading - Absolute Value
int absolute(const int value)
{
    return std::abs(value);
}

double absolute(const double value)
{
    return std::abs(value);
}

void absolute(std::vector<int>& vec)
{
    for (int& num : vec)
    {
        num = std::abs(num);
    }
}

// TASK 2: File Writing - Student Records
bool write_students(const std::string& filename, const std::vector<std::string>& names, const std::vector<int>& scores)
{
    if (names.size() != scores.size()) 
    {
        std::cerr << "Error: The number of names and scores do not match!" << std::endl;
        return false;
    }

    std::ofstream file(filename);
    if (!file.is_open()) 
    {
        std::cerr << "Error: Could not open file!" << std::endl;
        return false;
    }

    for (size_t i = 0; i < names.size(); ++i) 
    {
        file << "Name: " << names[i] << ", Score: " << scores[i] << std::endl;
    }

    file.close();
    return true;
}

// TASK 3: File Reading - Number Statistics
std::vector<double> read_numbers(const std::string& filename) {
    std::ifstream file(filename);
    std::vector<double> numbers;
    double num;

    if (file.is_open()) {
        while (file >> num) {
            numbers.push_back(num);
        }
        file.close();
    }

    return numbers;
}

int count_positive(const std::vector<double>& numbers) {
    int count = 0;
    for (double num : numbers) {
        if (num > 0) {
            count++;
        }
    }
    return count;
}

int count_negative(const std::vector<double>& numbers) {
    int count = 0;
    for (double num : numbers) {
        if (num < 0) {
            count++;
        }
    }
    return count;
}

// TASK 4: Reference Parameters - Sort Three Values
void sort_three(int& a, int& b, int& c)
{
    int arr[] = { a, b, c };
    std::sort(arr, arr + 3);
    a = arr[0];
    b = arr[1];
    c = arr[2];
}

void increment_all(int& a, int& b, int& c, const int value)
{
    a += value;
    b += value;
    c += value;
}

void make_equal(int& a, int& b, int& c)
{
    int avg = (a + b + c) / 3;
    a = avg;
    b = avg;
    c = avg;
}

// TASK 5: String Stream Processing
std::vector<int> parse_integers(const std::string& text)
{
    std::stringstream ss(text);
    std::vector<int> integers;
    int num;
    while (ss >> num)
    {
        integers.push_back(num);
    }
    return integers;
}

std::string join_strings(const std::vector<std::string>& words, const std::string& delimiter)
{
    std::stringstream ss;
    for (size_t i = 0; i < words.size(); ++i)
    {
        if (i != 0) ss << ", ";
        ss << words[i];
    }
    return ss.str();
}

int count_tokens(const std::string& text)
{
    std::stringstream ss(text);
    std::string token;
    int count = 0;

    while (ss >> token)
    {
        count++;
    }

    return count;
}

// TASK 6: Recursive Array Operations
int array_sum_recursive(const int array[], const int length, const int index = 0)
{
    if (index >= length) return 0;
    else return array[index] + array_sum_recursive(array, length, index + 1);
}

int find_max_recursive(const int array[], const int length, const int index = 0)
{
    if (index == length - 1) return array[index];
    return std::max(array[index], find_max_recursive(array, length, index + 1));
}

// TASK 7: Multi-File Data Processing
struct DataSummary {
    std::string filename;
    int line_count;
    int word_count;
    int char_count;
};

DataSummary analyze_file(const std::string& filename) {
    DataSummary summary = { filename, 0, 0, 0 };
    std::ifstream file(filename);

    if (!file.is_open()) {
        std::cerr << "Error: Could not open file " << filename << std::endl;
        return summary;
    }

    std::string line;
    while (std::getline(file, line)) 
    {
        summary.line_count++;
        summary.char_count += line.length();

        std::stringstream ss(line);
        std::string word;
        while (ss >> word) 
        {
            summary.word_count++;
        }
    }

    file.close();
    return summary;
}

void print_summary(const DataSummary& summary) 
{
    std::cout << "File: " << summary.filename << std::endl;
    std::cout << "Lines: " << summary.line_count << std::endl;
    std::cout << "Words: " << summary.word_count << std::endl;
    std::cout << "Characters: " << summary.char_count << std::endl;
}

void compare_files(const std::string& file1, const std::string& file2) 
{
    DataSummary summary1 = analyze_file(file1);
    DataSummary summary2 = analyze_file(file2);

    std::cout << "File 1 Summary:" << std::endl;
    print_summary(summary1);
    std::cout << "\nFile 2 Summary:" << std::endl;
    print_summary(summary2);

    std::cout << "Comparing files: " << summary1.filename << " and " << summary2.filename << std::endl;

    if (summary1.line_count > summary2.line_count) {
        std::cout << summary1.filename << " has more lines." << std::endl;
    }
    else if (summary1.line_count < summary2.line_count) {
        std::cout << summary2.filename << " has more lines." << std::endl;
    }
    else {
        std::cout << "Both files have the same number of lines." << std::endl;
    }

    if (summary1.word_count > summary2.word_count) {
        std::cout << summary1.filename << " has more words." << std::endl;
    }
    else if (summary1.word_count < summary2.word_count) {
        std::cout << summary2.filename << " has more words." << std::endl;
    }
    else {
        std::cout << "Both files have the same number of words." << std::endl;
    }

    if (summary1.char_count > summary2.char_count) {
        std::cout << summary1.filename << " has more characters." << std::endl;
    }
    else if (summary1.char_count < summary2.char_count) {
        std::cout << summary2.filename << " has more characters." << std::endl;
    }
    else {
        std::cout << "Both files have the same number of characters." << std::endl;
    }
}

